 {
  "id": "r1-002",
  "answer": "The train to Riga leaves at 7.15 every morning, and the film starts at eight tonight.",
  "other_correct": "",
  "wrong_options_that_fit": "",
  "instruction_problem": "The instruction does not say what grammar is wanted (present simple for timetabled future); a learner could write e.g. 'The shop was open until six' and still meet the instruction. 'A timetable ... a shop' is slightly odd (a shop has opening hours, not a timetable).",
  "level_problem": "",
  "sense_problem": ""
 },
 {
  "id": "r1-003",
  "answer": "If I had seen the sign, I wouldn't have parked there and I wouldn't have got a fine.",
  "other_correct": "If I'd seen the sign, I wouldn't have parked there. / If I had seen the sign, I wouldn't have got a fine. / If I had seen the sign, I wouldn't have parked there or got a fine. / ...and wouldn't have got a fine. / (AmE) ...gotten a fine.",
  "wrong_options_that_fit": "",
  "instruction_problem": "The source has two results (parked, got a fine); it is unclear whether one or both must appear in the answer, so many forms should be accepted.",
  "level_problem": "",
  "sense_problem": ""
 },
 {
